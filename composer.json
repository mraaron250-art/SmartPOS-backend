{
    "name": "smartpos/backend",
    "description": "SmartPOS REST API: PHP MVC + Eloquent ORM + PostgreSQL",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "firebase/php-jwt": "^7.2",
        "illuminate/database": "^13.38",
        "illuminate/events": "^13.38",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8000 -t public",
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.27",
            "ext-pdo_pgsql": "8.4.27"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
