# Copy to .env for local development. On Render these are set by render.yaml.
APP_NAME="SmartPOS API"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Either a full URL (Render style)...
DATABASE_URL=postgres://smartpos:smartpos@127.0.0.1:5433/smartpos
# ...or discrete values (used only when DATABASE_URL is empty)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=smartpos
DB_USERNAME=smartpos
DB_PASSWORD=smartpos
DB_SSLMODE=prefer

# 32+ random characters. Render generates one automatically.
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origins allowed to call the API directly (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
